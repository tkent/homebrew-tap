class Cairn < Formula
  desc "Knowledge in Open Knowledge Format (OKF) as a CLI and MCP server"
  homepage "https://github.com/tkent/cairn-releases"
  version "@VERSION@"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "https://github.com/tkent/cairn-releases/releases/download/v@VERSION@/cairn_@VERSION@_darwin_arm64.tar.gz"
      sha256 "@SHA_DARWIN_ARM64@"
    end
    on_intel do
      url "https://github.com/tkent/cairn-releases/releases/download/v@VERSION@/cairn_@VERSION@_darwin_amd64.tar.gz"
      sha256 "@SHA_DARWIN_AMD64@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/tkent/cairn-releases/releases/download/v@VERSION@/cairn_@VERSION@_linux_arm64.tar.gz"
      sha256 "@SHA_LINUX_ARM64@"
    end
    on_intel do
      url "https://github.com/tkent/cairn-releases/releases/download/v@VERSION@/cairn_@VERSION@_linux_amd64.tar.gz"
      sha256 "@SHA_LINUX_AMD64@"
    end
  end

  def install
    bin.install "cairn"
  end

  def caveats
    <<~EOS
      Git-sourced bundles need git on your PATH (the system git is fine).
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/cairn --version")
  end
end
